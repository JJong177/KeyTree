{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "KeyTree",
  "version": "0.1.0",
  "identifier": "com.keytree.app",
  "build": {
    "beforeDevCommand": "node node_modules/vite/bin/vite.js",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "node node_modules/vite/bin/vite.js build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "KeyTree",
        "width": 1100,
        "height": 700,
        "minWidth": 900,
        "minHeight": 600
      },
      {
        "label": "panel",
        "title": "KeyTree",
        "url": "index.html?panel=1",
        "width": 660,
        "height": 480,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "visible": false,
        "center": true,
        "shadow": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.png"
    ]
  }
}

# WorkBuddy 工作区 / WorkBuddy workspace
.workbuddy/
node_modules/
dist/
target/
tmp/
*.log

# 构建产物与临时输出 / build artifacts & temp output
*.exe
cli-out.txt

# 密码库与敏感产物一律不进 git（真实库 + 恢复候选列表）
# Vault files & sensitive artifacts never enter git (real vaults + recovery candidates)
*.kdbx
# 滚动备份 / 损坏留证：同样是明文加密库的完整副本
# Rolling backups / corruption evidence: full encrypted-vault copies too
*.kdbx.bak
*.kdbx.corrupt-*
recovery-candidates.txt
recovery-result.txt

# 设计与开发过程资料仅留本地 / local-only design and planning
/design/
/docs/design/
/docs/superpowers/

# 内部记录、日志与本地预览 / internal records, logs and local previews
logs/
*.log.*
*.dmp
*.tmp
/keytree/release/验收报告.md
/assets/readme/preview.html

# 一次性密码库工具仅留本地 / one-off local vault utilities
/keytree/scripts/recover-master.mjs
/keytree/scripts/read-external-vault.mjs
/keytree/scripts/gen-external-vault.py

# 本机凭据与密码库附属文件 / local credentials and vault sidecars
.env
.env.*
!.env.example
*.key
*.keyx
*.kdbx.*
*.keytree-backups/

# 本地依赖的必要发布文件 / required vendored runtime and type declarations
!/keytree/vendor/kdbxweb/dist/
/keytree/vendor/kdbxweb/dist/*
!/keytree/vendor/kdbxweb/dist/kdbxweb.js
!/keytree/vendor/kdbxweb/dist/types/
